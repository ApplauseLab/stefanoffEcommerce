# Allow-list: the repo holds only what builds the site. Research, audit, screenshots and backups stay local.
/*
!/.gitignore
!/.github/
!/site/
!/redesign/
!/styleguide/
!/assets/

/site/dist/
/site/shots/
/site/i18n/missing.txt
__pycache__/
.DS_Store

/redesign/*
!/redesign/build.py
!/redesign/src/
/redesign/src/*
!/redesign/src/img/
!/redesign/src/video/
!/redesign/src/docs/

/styleguide/*
!/styleguide/tokens.css
!/styleguide/assets/
/styleguide/assets/*
!/styleguide/assets/mark-line-*.png
!/styleguide/assets/wordmark-*.png

/assets/*
!/assets/manifest.md
